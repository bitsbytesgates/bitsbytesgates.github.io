    "marked": "^18.0.10",
    "mermaid": "^11.17.1",
    "sanitize-html": "^2.17.7",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "pagefind": "^1.5.2",
    "wrangler": "^4.125.0"
