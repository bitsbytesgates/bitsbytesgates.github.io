---
// Rendered only on posts that actually contain a .mermaid block — mermaid is ~500 KB,
// and only 11 of 81 posts use it. The Jekyll site imported it from jsDelivr on every
// page that set `mermaid: true` in front matter (29 posts), including ones with no
// diagram at all.
---
<script>
  const nodes = document.querySelectorAll<HTMLElement>('.mermaid')
  if (nodes.length) {
    const { default: mermaid } = await import('mermaid')

    // Keep the source around: mermaid replaces the div's contents with SVG, so a
    // re-render on theme change needs the original text back.
    for (const n of nodes) n.dataset.src ??= n.textContent ?? ''

    const isDark = () => {
      const explicit = document.documentElement.getAttribute('data-theme')
      return explicit ? explicit === 'dark'
                      : matchMedia('(prefers-color-scheme: dark)').matches
    }

    const draw = async () => {
      for (const n of nodes) {
        n.removeAttribute('data-processed')
        n.textContent = n.dataset.src ?? ''
      }
      mermaid.initialize({
        startOnLoad: false,
        theme: isDark() ? 'dark' : 'default',
        securityLevel: 'strict',
      })
      await mermaid.run({ nodes: Array.from(nodes) })
    }

    await draw()

    // Re-render on both toggle and OS-level changes.
    new MutationObserver(draw).observe(document.documentElement, {
      attributes: true, attributeFilter: ['data-theme'],
    })
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (!document.documentElement.getAttribute('data-theme')) draw()
    })
  }
</script>
