---
import { formatDate, type Post } from '../lib/topics'
interface Props { posts: Post[] }
const { posts } = Astro.props
---
{posts.length > 0 && (
  <section aria-labelledby="related">
    <h2 id="related">Related</h2>
    <ul class="card-list">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}/`}>{p.data.title}</a>
          <div class="meta"><time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time></div>
        </li>
      ))}
    </ul>
  </section>
)}
