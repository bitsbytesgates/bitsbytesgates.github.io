---
import { topicSlug } from '../lib/topics'
interface Props { topics: string[]; counts?: Map<string, number> }
const { topics, counts } = Astro.props
---
{topics.length > 0 && (
  <ul class="chips">
    {topics.map((t) => (
      <li>
        <a class="chip" href={`/topics/${topicSlug(t)}/`}>
          {t}{counts && <span class="n"> {counts.get(topicSlug(t))}</span>}
        </a>
      </li>
    ))}
  </ul>
)}
