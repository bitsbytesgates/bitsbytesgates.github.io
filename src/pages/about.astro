---
import BaseLayout from '../layouts/BaseLayout.astro'
import Subscribe from '../components/Subscribe.astro'
import { marked } from 'marked'
import { readFileSync } from 'node:fs'
const html = await marked.parse(readFileSync('./src/content-about.md', 'utf8'))
---
<BaseLayout title="About" description="Matthew Ballance — verification methodology and automation, Portland, Oregon.">
  <div class="prose"><h1>About</h1><Fragment set:html={html} /><Subscribe /></div>
</BaseLayout>
