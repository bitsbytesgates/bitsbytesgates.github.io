---
import type { GetStaticPaths, Page } from 'astro'
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import { byDateDesc, type Post } from '../lib/topics'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDateDesc)
  return paginate(posts, { pageSize: 10 })
}

const { page } = Astro.props as { page: Page<Post> }

// Astro emits page.url.prev/next without a trailing slash ("/2"), but the pages
// are directories, so Cloudflare 308s "/2" to "/2/". Linking the slashed form
// keeps every internal link a single hop.
const slash = (u: string | undefined) => (u && u !== '/' && !u.endsWith('/') ? u + '/' : u)
const prev = slash(page.url.prev)
const next = slash(page.url.next)
---
<BaseLayout title={page.currentPage === 1 ? 'Bits, Bytes, and Gates' : `Page ${page.currentPage}`}>
  {page.currentPage === 1 ? (
    <>
      <h1>Bits, Bytes, and Gates</h1>
      <p>Notes on portable stimulus, hardware modeling, and Python in design verification.</p>
    </>
  ) : (
    <h1>Posts — page {page.currentPage}</h1>
  )}
  <ul class="card-list">
    {page.data.map((post) => <PostCard post={post} />)}
  </ul>
  <nav class="pagination" aria-label="Pagination">
    {prev ? <a href={prev}>← Newer</a> : <span />}
    <span>Page {page.currentPage} of {page.lastPage}</span>
    {next ? <a href={next}>Older →</a> : <span />}
  </nav>
</BaseLayout>
