---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="Search" description="Search every post on Bits, Bytes, and Gates.">
  <h1>Search</h1>
  <div id="search"></div>
  <noscript><p>Search needs JavaScript. The <a href="/archive/">archive</a> and
    <a href="/topics/">topics</a> pages work without it.</p></noscript>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (!window.PagefindUI) return
      new window.PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        excerptLength: 30,
        // Pagefind keeps queries entirely client-side and puts nothing in the
        // URL, so search terms are invisible to analytics unless sent here.
        // This runs on the settled query, not per keystroke: the UI debounces
        // 300ms before the call that applies processTerm, and the per-keystroke
        // preload() bypasses it. gtag may be absent (DNT, preview, dev), hence
        // the optional call rather than a guard.
        processTerm: (term) => {
          window.gtag?.('event', 'search', { search_term: term })
          return term
        },
      })
    })
  </script>
</BaseLayout>
