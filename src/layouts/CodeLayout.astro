---
import BaseLayout from './BaseLayout.astro'
const { frontmatter } = Astro.props
const title = frontmatter?.title ?? 'Code listing'
---
<BaseLayout title={title} description="Source listing from a Bits, Bytes, and Gates post.">
  <div class="prose">
    <h1>{title}</h1>
    <slot />
  </div>
</BaseLayout>
